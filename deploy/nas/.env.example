PUBLIC_ORIGIN=https://localhost:8443
PUBLIC_HOST=localhost
WEB_BIND_IP=127.0.0.1
WEB_PORT=8081
HTTPS_PORT=8443
# Set this absolute path to the existing MongoDB data directory BEFORE starting.
MONGO_DATA_DIR=./data
APP_TAG=0.1.6
# local includes a starter MongoDB; external runs the management platform only.
DEPLOYMENT_MODE=local
COMPOSE_FILE=compose.yaml
COMPOSE_PATH_SEPARATOR=:
# Google-only/SMTP: add :compose.integrations.yaml and create its private secret files.
AUTH_MODE=mixed
# SMTP_HOST=mail.example.invalid
# Renewal reminders are opt-in and require configured SMTP; expiry checks run automatically.
SUBSCRIPTION_REMINDERS_ENABLED=false
SUBSCRIPTION_REMINDER_DAYS=3
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_FROM=notifications@example.invalid
# Comma-separated approved database hostnames; add external hosts in your private .env.
DATABASE_ALLOWED_HOSTS=documentdb
DATABASE_ALLOW_PRIVATE=true
# Change all four together if this subnet overlaps a NAS/VPN network.
PROXY_SUBNET=172.30.240.0/28
INGRESS_IP=172.30.240.2
TUNNEL_IP=172.30.240.3
APP_PROXY_IP=172.30.240.4
